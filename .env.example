# ==============================================================================
# AZ OVERVERSE - Production Custom Auth Environment Variables
# Compatible with Neon.tech Postgres / Supabase Postgres / Cloud SQL & Resend
# ==============================================================================

# PostgreSQL Connection String (Neon.tech pooled connection with ?pgbouncer=true&connect_timeout=15)
DATABASE_URL="postgresql://neondb_owner:npg_secret@ep-bold-glitter-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# JWT Secret: Cryptographic secret (minimum 32 characters) for signing 15m access, 7d refresh, and 1d verification JWTs
JWT_SECRET="replace-with-a-64-character-random-production-secret-hex-string"

# Resend API Key: For transactional verification & password reset emails
RESEND_API_KEY="re_1234567890abcdef"

# Verified sender email address in Resend (default test domain: onboarding@resend.dev)
RESEND_FROM_EMAIL="AZ OVERVERSE <onboarding@resend.dev>"

# Next.js / App Public URL (used for verification links and redirect origins)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
