# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_APP_URL: Public base URL used for email verification & password reset links.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT_SECRET: Cryptographic secret (minimum 32 characters) for signing 15m access, 7d refresh, and 1d verification JWTs.
JWT_SECRET="replace-with-a-64-character-random-production-secret"

# RESEND_API_KEY: Resend API key for sending Creator Account verification and password reset emails.
RESEND_API_KEY="re_xxxxxxxxx"

# RESEND_FROM_EMAIL: Verified sender identity in Resend (falls back to onboarding@resend.dev in testing).
RESEND_FROM_EMAIL="AZ OVERVERSE Creators <onboarding@resend.dev>"
