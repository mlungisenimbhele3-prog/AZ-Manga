rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAuthenticated();

      // Reading progress subcollection
      match /reading_progress/{mangaId} {
        allow read, write: if isOwner(userId) || isAuthenticated();
      }

      // Bookmarks subcollection
      match /bookmarks/{mangaId} {
        allow read, write: if isOwner(userId) || isAuthenticated();
      }

      // Reading preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId) || isAuthenticated();
      }
    }

    // Chat messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.token.email == resource.data.senderId);
    }

    // Chat groups
    match /chat_groups/{groupId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.createdBy || request.auth.token.email == resource.data.createdBy);
    }

    // Mangas and chapters collections
    match /mangas/{mangaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
