{
  "entities": {
    "userPublicProfile": {
      "title": "User Public & Creator Studio Profile",
      "description": "Public reader and Creator Studio profile without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "isCreator": {
          "type": "boolean"
        },
        "penName": {
          "type": "string",
          "maxLength": 80
        },
        "studioName": {
          "type": "string",
          "maxLength": 80
        },
        "primaryGenres": {
          "type": "array",
          "description": "Up to 6 primary manga genres for Creator Studio"
        },
        "followersCount": {
          "type": "number"
        },
        "followingCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "isCreator", "createdAt", "updatedAt"]
    },
    "userPrivateInfo": {
      "title": "User Private PII Record",
      "description": "Isolated PII record accessible strictly by the account owner or admin",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "readingProgress": {
      "title": "Reading Progress",
      "description": "User reading state and chapter progress per manga series",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaTitle": {
          "type": "string",
          "maxLength": 160
        },
        "mangaCover": {
          "type": "string",
          "maxLength": 1000
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterNumber": {
          "type": "number"
        },
        "chapterTitle": {
          "type": "string",
          "maxLength": 160
        },
        "pageNumber": {
          "type": "number"
        },
        "totalPages": {
          "type": "number"
        },
        "progressPercent": {
          "type": "number"
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "chapterId", "chapterNumber", "pageNumber", "totalPages", "progressPercent", "createdAt", "updatedAt"]
    },
    "bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked favorite manga series",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaTitle": {
          "type": "string",
          "maxLength": 160
        },
        "coverImage": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "createdAt", "updatedAt"]
    },
    "readingPreference": {
      "title": "Reading Preferences",
      "description": "Reader preferences including theme, text size, and scroll direction",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "amoled", "sepia"],
          "maxLength": 20
        },
        "textSize": {
          "type": "string",
          "enum": ["small", "medium", "large", "xlarge"],
          "maxLength": 20
        },
        "readingDirection": {
          "type": "string",
          "enum": ["vertical", "horizontal_rtl", "horizontal_ltr", "single"],
          "maxLength": 30
        },
        "autoScroll": {
          "type": "boolean"
        },
        "autoScrollSpeed": {
          "type": "number"
        },
        "soundEffects": {
          "type": "boolean"
        },
        "hapticFeedback": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "textSize", "readingDirection", "createdAt", "updatedAt"]
    },
    "adminRecord": {
      "title": "Admin Directory Record",
      "description": "Trusted administrator membership document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "mangaSeries": {
      "title": "Manga Series",
      "description": "Published manga series authored by a verified Creator Account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "synopsis": {
          "type": "string",
          "maxLength": 2000
        },
        "coverImage": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["ONGOING", "COMPLETED", "HIATUS"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "title", "author", "status", "createdAt", "updatedAt"]
    },
    "mangaChapter": {
      "title": "Manga Chapter",
      "description": "Published manga chapter belonging to a parent manga series",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "number": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pageCount": {
          "type": "number"
        },
        "accessType": {
          "type": "string",
          "enum": ["free", "premium", "rewarded"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "mangaId", "authorUid", "number", "title", "pageCount", "accessType", "createdAt", "updatedAt"]
    },
    "chatGroup": {
      "title": "Chat Group",
      "description": "Manga fan club or creator community circle",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "maxLength": 1000
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "membersCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "createdBy", "createdAt", "updatedAt"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "description": "Direct message or group chat message",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderAvatar": {
          "type": "string",
          "maxLength": 1000
        },
        "recipientId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "senderId", "senderName", "text", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userPublicProfile",
      "description": "Public user and Creator Studio profile without PII"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "userPrivateInfo",
      "description": "Isolated PII record (email) readable strictly by owner or admin"
    },
    "/users/{userId}/reading_progress/{mangaId}": {
      "schema": "readingProgress",
      "description": "User chapter and page reading progress"
    },
    "/users/{userId}/bookmarks/{mangaId}": {
      "schema": "bookmark",
      "description": "User bookmarked manga series"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "readingPreference",
      "description": "User reader preferences (theme, text size, scroll)"
    },
    "/admins/{adminId}": {
      "schema": "adminRecord",
      "description": "Trusted administrator directory"
    },
    "/mangas/{mangaId}": {
      "schema": "mangaSeries",
      "description": "Published manga series authored by verified Creator Accounts"
    },
    "/chapters/{chapterId}": {
      "schema": "mangaChapter",
      "description": "Published chapters belonging to a manga series"
    },
    "/chat_groups/{groupId}": {
      "schema": "chatGroup",
      "description": "Reader groups and creator fan clubs"
    },
    "/chat_messages/{messageId}": {
      "schema": "chatMessage",
      "description": "Direct and group messages"
    }
  }
}
