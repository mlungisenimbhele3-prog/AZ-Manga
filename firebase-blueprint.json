{
  "entities": {
    "userPublicProfile": {
      "title": "User Public & Creator Studio Profile",
      "description": "Public reader and Creator Studio profile without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "maxLength": 500
        },
        "isCreator": {
          "type": "boolean"
        },
        "penName": {
          "type": "string",
          "maxLength": 80
        },
        "studioName": {
          "type": "string",
          "maxLength": 80
        },
        "primaryGenres": {
          "type": "array",
          "description": "Up to 6 primary manga genres for Creator Studio"
        },
        "followersCount": {
          "type": "number"
        },
        "followingCount": {
          "type": "number"
        },
        "role": {
          "type": "string",
          "enum": ["reader", "creator", "admin"]
        },
        "creatorStatus": {
          "type": "string",
          "enum": ["none", "pending", "approved", "rejected"]
        },
        "blockedUsers": {
          "type": "array",
          "description": "List of user IDs blocked by this user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "isCreator", "createdAt", "updatedAt"]
    },
    "userPrivateInfo": {
      "title": "User Private PII Record",
      "description": "Isolated PII record (email and/or verified phone number) accessible strictly by the account owner or admin",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^\\+[1-9][0-9]{6,18}$",
          "description": "Verified E.164 phone number from Firebase Phone Auth"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "readingProgress": {
      "title": "Reading Progress",
      "description": "User reading state and chapter progress per manga series",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaTitle": {
          "type": "string",
          "maxLength": 160
        },
        "mangaCover": {
          "type": "string",
          "maxLength": 1000
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterNumber": {
          "type": "number"
        },
        "chapterTitle": {
          "type": "string",
          "maxLength": 160
        },
        "pageNumber": {
          "type": "number"
        },
        "totalPages": {
          "type": "number"
        },
        "progressPercent": {
          "type": "number"
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "chapterId", "chapterNumber", "pageNumber", "totalPages", "progressPercent", "createdAt", "updatedAt"]
    },
    "bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked favorite manga series",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaTitle": {
          "type": "string",
          "maxLength": 160
        },
        "coverImage": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "createdAt", "updatedAt"]
    },
    "readingPreference": {
      "title": "Reading Preferences",
      "description": "Reader preferences including theme, text size, and scroll direction",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "amoled", "sepia"],
          "maxLength": 20
        },
        "textSize": {
          "type": "string",
          "enum": ["small", "medium", "large", "xlarge"],
          "maxLength": 20
        },
        "readingDirection": {
          "type": "string",
          "enum": ["vertical", "horizontal_rtl", "horizontal_ltr", "single"],
          "maxLength": 30
        },
        "autoScroll": {
          "type": "boolean"
        },
        "autoScrollSpeed": {
          "type": "number"
        },
        "soundEffects": {
          "type": "boolean"
        },
        "hapticFeedback": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "textSize", "readingDirection", "createdAt", "updatedAt"]
    },
    "adminRecord": {
      "title": "Admin Directory Record",
      "description": "Trusted administrator membership document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "mangaSeries": {
      "title": "Manga Series",
      "description": "Published manga series authored by a verified Creator Account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "synopsis": {
          "type": "string",
          "maxLength": 2000
        },
        "coverImage": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["ONGOING", "COMPLETED", "HIATUS"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "title", "author", "status", "createdAt", "updatedAt"]
    },
    "mangaChapter": {
      "title": "Manga Chapter",
      "description": "Published manga chapter belonging to a parent manga series",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "number": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "pageCount": {
          "type": "number"
        },
        "accessType": {
          "type": "string",
          "enum": ["free", "premium", "rewarded"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "mangaId", "authorUid", "number", "title", "pageCount", "accessType", "createdAt", "updatedAt"]
    },
    "chatGroup": {
      "title": "Chat Group",
      "description": "Manga fan club or creator community circle",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "maxLength": 1000
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "membersCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "createdBy", "createdAt", "updatedAt"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "description": "Direct message or group chat message",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderAvatar": {
          "type": "string",
          "maxLength": 1000
        },
        "recipientId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "senderId", "senderName", "text", "createdAt", "updatedAt"]
    },
    "userRating": {
      "title": "User Rating",
      "description": "Individual 1-5 star rating submitted by a verified user for a manga series, volume, or chapter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "summaryId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 90,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["manga", "volume", "chapter"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "volumeNumber": {
          "type": "integer"
        },
        "chapterId": {
          "type": "string",
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "score": {
          "type": "integer",
          "enum": [1, 2, 3, 4, 5]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "summaryId",
        "uid",
        "targetType",
        "targetId",
        "mangaId",
        "score",
        "createdAt",
        "updatedAt"
      ]
    },
    "ratingSummary": {
      "title": "Rating Summary",
      "description": "Public aggregated rating statistics (sum, count, average 1-5) for a manga series, volume, or chapter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 90,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "enum": ["manga", "volume", "chapter"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "volumeNumber": {
          "type": "integer"
        },
        "chapterId": {
          "type": "string",
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ratingSum": {
          "type": "integer"
        },
        "ratingCount": {
          "type": "integer"
        },
        "averageRating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "targetType",
        "targetId",
        "mangaId",
        "ratingSum",
        "ratingCount",
        "averageRating",
        "createdAt",
        "updatedAt"
      ]
    },
    "chapterComment": {
      "title": "Chapter Comment & Threaded Reply",
      "description": "Public chapter comment or nested threaded reply linked via parentId and rootId without PII",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterNumber": {
          "type": "integer",
          "description": "1-indexed chapter number"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent comment ID when depth >= 1"
        },
        "rootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Top-level thread root comment ID when depth >= 1"
        },
        "depth": {
          "type": "integer",
          "enum": [0, 1, 2, 3, 4],
          "description": "Thread nesting depth (0 for root comment, 1-4 for nested replies)"
        },
        "replyToUserName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the reader being directly replied to"
        },
        "pageNumber": {
          "type": "integer",
          "description": "Optional 1-indexed chapter page reference"
        },
        "isSpoiler": {
          "type": "boolean",
          "description": "Whether comment text is masked behind a spoiler warning"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorBadge": {
          "type": "string",
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["published", "deleted"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "mangaId",
        "chapterId",
        "chapterNumber",
        "depth",
        "isSpoiler",
        "authorUid",
        "authorName",
        "text",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "chapterCommentLike": {
      "title": "Chapter Comment Like",
      "description": "Deterministic per-user like record (commentId__uid) for a chapter comment or reply",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 76,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "commentId", "chapterId", "mangaId", "uid", "createdAt"]
    },
    "report": {
      "title": "Safety Report",
      "description": "User moderation report for abusive messages and accounts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reporterUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reportedUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "messageId": {
          "type": "string",
          "maxLength": 128
        },
        "messageText": {
          "type": "string",
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "maxLength": 80
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "maxLength": 20
        }
      },
      "required": ["id", "reporterUserId", "reportedUserId", "reason", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userPublicProfile",
      "description": "Public user and Creator Studio profile without PII"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "userPrivateInfo",
      "description": "Isolated PII record (email) readable strictly by owner or admin"
    },
    "/users/{userId}/reading_progress/{mangaId}": {
      "schema": "readingProgress",
      "description": "User chapter and page reading progress"
    },
    "/users/{userId}/bookmarks/{mangaId}": {
      "schema": "bookmark",
      "description": "User bookmarked manga series"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "readingPreference",
      "description": "User reader preferences (theme, text size, scroll)"
    },
    "/admins/{adminId}": {
      "schema": "adminRecord",
      "description": "Trusted administrator directory"
    },
    "/mangas/{mangaId}": {
      "schema": "mangaSeries",
      "description": "Published manga series authored by verified Creator Accounts"
    },
    "/chapters/{chapterId}": {
      "schema": "mangaChapter",
      "description": "Published chapters belonging to a manga series"
    },
    "/chat_groups/{groupId}": {
      "schema": "chatGroup",
      "description": "Reader groups and creator fan clubs"
    },
    "/chat_messages/{messageId}": {
      "schema": "chatMessage",
      "description": "Direct and group messages"
    },
    "/ratings/{ratingId}": {
      "schema": "userRating",
      "description": "Per-user 1-5 star rating documents for manga, volumes, and chapters"
    },
    "/rating_summaries/{summaryId}": {
      "schema": "ratingSummary",
      "description": "Public aggregate rating counters and averages atomically linked to user ratings"
    },
    "/chapter_comments/{commentId}": {
      "schema": "chapterComment",
      "description": "Public chapter comments and nested threaded replies verified against parent comments"
    },
    "/chapter_comment_likes/{likeId}": {
      "schema": "chapterCommentLike",
      "description": "Deterministic per-user likes on chapter comments and replies"
    },
    "/reports/{reportId}": {
      "schema": "report",
      "description": "User submitted safety and moderation reports reviewed by admin"
    }
  }
}
